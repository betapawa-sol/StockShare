# Copy to .env and fill in.

# Postgres connection string used by the Prisma CLI (migrate deploy, etc).
# Must be a DIRECT (non-pooled) connection — migrate deploy holds a
# session-level advisory lock that poolers like PgBouncer don't support.
# Locally: postgresql://user:password@localhost:5432/dbname?schema=public
# Supabase: use the "Direct connection" / POSTGRES_URL_NON_POOLING string.
DATABASE_URL=

# Pooled connection string used by the app at runtime (src/lib/db.ts) — each
# concurrent serverless invocation opens its own connection, so pooling matters.
# Supabase: use the "Transaction pooler" / POSTGRES_PRISMA_URL string (port 6543).
# Falls back to DATABASE_URL when unset (fine for local dev / unpooled Postgres).
POSTGRES_PRISMA_URL=

# Signs session JWTs (src/lib/session.ts). Generate with: openssl rand -base64 32
# Required in production — the app throws on boot without it.
SESSION_SECRET=

# "seed" (default) drives the app off deterministic demo data. "scrape" attempts
# the NGX public price-list scraper — see README's "About the NGX data source".
MARKET_DATA_PROVIDER=seed
